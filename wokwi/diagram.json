    { "type": "wokwi-led", "id": "led_indicativo", "top": 60, "left": 200, "attrs": { "color": "green", "label": "LED indicativo" } },
    { "type": "wokwi-resistor", "id": "r_led", "top": 60, "left": 160, "attrs": { "value": "220" } },

    { "type": "wokwi-buzzer", "id": "buzzer1", "top": 140, "left": 200, "attrs": {} },

